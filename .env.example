# PromptHub server environment.
# Copy to .env.local (git-ignored) and fill in any keys you have. All are optional:
# with none set, the app runs in Basic Mode (local templates, clearly labeled, no AI).
# These are read on the server only. Never rename them with a NEXT_PUBLIC_ prefix.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: fallback order (comma-separated: anthropic, openai, google)
PROVIDER_ORDER=anthropic,openai,google

# Optional: model overrides (defaults are set in src/lib/ai/registry.ts)
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=

# Optional: requests per minute per IP across /api/clarify, /api/generate, /api/transform (default 30)
RATE_LIMIT_PER_MINUTE=

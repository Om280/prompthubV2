# PromptHub environment.
# Copy to .env.local (git-ignored). Everything is optional: with nothing set, the app runs in Basic
# Mode (local templates, clearly labelled, no AI) and sign-in is disabled.
# Setup guide: docs/AUTH_SETUP.md

# --- Supabase Auth (Google sign-in) ---
# Both values are PUBLIC by design (they ship to the browser): the project URL and the publishable
# key. NEXT_PUBLIC_ values are inlined by `next build`, so set them before building (and in your
# host's build environment). Leave both empty to run without sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (sb_secret_...). Used ONLY by the server to run the AI quota
# functions (supabase/migrations/0001_ai_quota.sql). Never prefix with NEXT_PUBLIC_, never expose it.
# Without it AI stays off ("not configured"); Basic Mode and sign-in still work.
SUPABASE_SECRET_KEY=

# --- AI: Google Gemini, FREE TIER ONLY (server-only) ---
# Create the key in Google AI Studio in a Google Cloud project with NO billing account.
# Never link billing to that project: PromptHub must only ever run on the free tier.
# Used for clarify, generate, improve, shorten, expand, tone and regenerate. Signed-in users only.
# Free-tier content may be used by Google to improve its products (disclosed on /privacy).
GEMINI_API_KEY=
# Required. Must be on the free-tier allowlist in src/lib/ai/gemini-models.ts (no default, never
# substituted). Recommended: gemini-3.8-flash (stable, free tier; verified 2026-11-24). Paid-only, Pro,
# image and Omni models are refused.
GEMINI_MODEL=
# Thinking effort for Gemini 3.x: low (default), medium or high. "minimal" errors on gemini-3.8-flash.
# Thinking tokens count as output tokens.
GEMINI_THINKING_LEVEL=low
# Emergency switch: set to false to stop every Gemini call immediately (Basic Mode keeps working).
AI_ENABLED=true

# The model's free-tier limits for YOUR project, copied from https://aistudio.google.com/rate-limit
# (requests per minute, tokens per minute, requests per day). Optional but recommended: when set,
# PromptHub uses at most AI_GLOBAL_SAFETY_RATIO of each (default 0.7 = 70%). When not set, the
# conservative app-wide defaults below apply instead (they are PromptHub safeguards, not Google limits).
GEMINI_PROJECT_RPM=
GEMINI_PROJECT_TPM=
GEMINI_PROJECT_RPD=
AI_GLOBAL_SAFETY_RATIO=0.7
# App-wide ceilings across all users. Defaults 5 / 100000 / 100. With project limits set, the lower of
# these and the 70% value wins when you set them explicitly.
AI_GLOBAL_RPM=
AI_GLOBAL_TPM=
AI_GLOBAL_RPD=

# --- AI limits (optional; defaults shown). Enforced persistently in Supabase. ---
# New prompt workflows per user per Pacific day (clarify + generate of one idea count once).
AI_USER_DAILY_WORKFLOWS=5
# Improve, Shorten, Expand, Tone and Regenerate per user per Pacific day.
AI_USER_DAILY_REFINEMENTS=5
AI_USER_PER_MINUTE=3
AI_IP_PER_MINUTE=10
AI_MAX_CONCURRENT_PER_USER=1
# How long an in-flight lease lives if a request crashes without releasing it.
AI_INFLIGHT_TTL_SECONDS=120
# Idea, answers and prompt text combined, per request.
AI_MAX_INPUT_CHARS=20000
# Per Gemini call, thinking included.
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_MS=30000

# --- Basic Mode (server-only) ---
# Requests per minute per IP across /api/clarify, /api/generate, /api/transform (default 30).
RATE_LIMIT_PER_MINUTE=

# PromptHub environment.
# Copy to .env.local (git-ignored). Everything is optional: with nothing set, the app runs in Basic
# Mode (local templates, clearly labelled, no AI) and sign-in is disabled.

# --- Supabase Auth (Google sign-in). See docs/AUTH_SETUP.md. ---
# Both values are PUBLIC by design (they ship to the browser): the project URL and the publishable
# key. Never put a service-role or secret key here; PromptHub doesn't use one.
# NEXT_PUBLIC_ values are inlined by `next build`, so set them before building (and in your host's
# build environment). Leave both empty to run without sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Abuse limits (server-only) ---
# Requests per minute per IP across /api/clarify, /api/generate, /api/transform (default 30).
RATE_LIMIT_PER_MINUTE=
# Requests per minute per signed-in user across the same routes (default 20).
RATE_LIMIT_PER_USER_PER_MINUTE=
